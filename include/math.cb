// A static class providing common mathematical functions and constants.

// Link to the native library. This must be at the top level.
link "cobra_math";

// Low-level external function declarations. These must be at the top level.
external double math_abs(double x);
external double math_sin(double x);
external double math_cos(double x);
external double math_ceil(double x);
external double math_floor(double x);
external double math_round(double x);
external int math_is_prime(int n); // Changed to return int
external double math_lerp(double a, double b, double t);

namespace System {
    class Math {
        static double PI = 3.141592653589793;
        static double E = 2.718281828459045;

        static double abs(double x) { return math_abs(x); }
        static double sin(double x) { return math_sin(x); }
        static double cos(double x) { return math_cos(x); }
        static double ceil(double x) { return math_ceil(x); }
        static double floor(double x) { return math_floor(x); }
        static double round(double x) { return math_round(x); }
        static bool isPrime(int n) { return math_is_prime(n) == 1; } // Convert int to bool
        static double lerp(double a, double b, double t) { return math_lerp(a, b, t); }
    }
}
