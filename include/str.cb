// The Cobra String class, providing a high-level, object-oriented interface
// for native string manipulation.

// Link to the native library. This must be at the top level.
link "cobra_str";

// Low-level external function declarations. These must be at the top level.
external handle str_create(string initial_value);
external void str_delete(handle h);
external string str_get_as_string(handle h);
external int str_length(handle h);
external bool str_is_empty(handle h);
external bool str_contains(handle h, string sub);
external handle str_to_upper(handle h);
external handle str_to_lower(handle h);
external handle str_substring(handle h, int start, int len);
external handle str_replace(handle h, string old_str, string new_str);

namespace System {
    class String {
        // The handle to the native C++ string object.
        // The underscore is a convention to indicate it's for internal use.
        handle _handle;

        // Constructor for creating an empty string.
        constructor() {
            this._handle = str_create("");
        }

        // Constructor from a standard Cobra string.
        constructor(string initial_value) {
            this._handle = str_create(initial_value);
        }

        // Private constructor for internal use. This is simulated by convention
        // as the language doesn't have private constructors. It takes a handle
        // that has already been created by another native function.
        constructor(handle h, bool is_internal) {
            this._handle = h;
        }

        // Destructor automatically frees the native string memory.
        destructor() {
            str_delete(this._handle);
        }

        // Returns the string's content for printing or use with built-in strings.
        string toString() {
            return str_get_as_string(this._handle);
        }

        // Returns the number of characters in the string.
        int length() {
            return str_length(this._handle);
        }

        // Returns true if the string is empty.
        bool isEmpty() {
            return str_is_empty(this._handle);
        }

        // Returns true if the string contains the given substring.
        bool contains(string substring) {
            return str_contains(this._handle, substring);
        }

        // Returns a new String object with all characters converted to uppercase.
        String toUpper() {
            handle new_handle = str_to_upper(this._handle);
            return new String(new_handle, true);
        }

        // Returns a new String object with all characters converted to lowercase.
        String toLower() {
            handle new_handle = str_to_lower(this._handle);
            return new String(new_handle, true);
        }

        // Returns a new String object containing a portion of the original string.
        String substring(int start, int len) {
            handle new_handle = str_substring(this._handle, start, len);
            return new String(new_handle, true);
        }

        // Returns a new String object with all occurrences of a substring replaced.
        String replace(string old_sub, string new_sub) {
            handle new_handle = str_replace(this._handle, old_sub, new_sub);
            return new String(new_handle, true);
        }
    }
}
